# rust/.env.example
#
# Credentials for the Rust dev tools (`dryrun`, `faculty_fetch`). Copy this to
# rust/.env and run the tools from the rust/ directory. If a value is missing,
# the tool prompts for it instead.
#
# IMPORTANT: Never commit your .env file with sensitive data.
#

VTOP_USERNAME=YOUR_VTOP_USERNAME
VTOP_PASSWORD=YOUR_VTOP_PASSWORD
